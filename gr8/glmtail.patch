 #include <chrono>
 #include <cstddef>
 #include <cstdint>
+#include <cstdlib>
 #include <cstring>
 #include <functional>
 #include <limits>
@@ -68,6 +69,19 @@ inline const char* flash_cache_name(FlashCache m) {
 // the last cold prefill quantum boundary at or before the prompt's prefilled rows (prompt_tokens - 1: the last prompt
 // token runs as the prompt-tail step). 0 = none. A quantum is full only while more than one lane's rows are left, so
 // every quantum but the last starts and ends on the grid.
+// GLMTAIL=1: the turn-tail point (scheduler-rs flash_tail_point, the same rule): the last 64-row page boundary at
+// or before row prompt_tokens - 1 - GLMTAIL_BACK (default 1). The scheduler ends a prefill quantum there. NOT
+// cold-exact: a later prompt that hits it is prefilled from a point a cold prefill's quanta do not end on.
+inline uint32_t flash_tail_point(uint32_t prompt_tokens) {
+    static const int back = [] {
+        const char* on = getenv("GLMTAIL");
+        if (!on || std::string(on) != "1") return -1;
+        const char* b = getenv("GLMTAIL_BACK");
+        return b ? atoi(b) : 1;
+    }();
+    if (back < 0 || prompt_tokens <= uint32_t(back) + 1) return 0;
+    return (prompt_tokens - 1 - uint32_t(back)) / 64 * 64;
+}
 inline uint32_t aligned_point(uint32_t prompt_tokens, uint32_t grid) {
     if (!grid || prompt_tokens < 1) return 0;
     return (prompt_tokens - 1) / grid * grid;
