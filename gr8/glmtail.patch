+
+/// GLMTAIL=1 (GLM-5.3-Flash checkpoints): the turn-tail point of a prompt, the last 64-row page boundary at or
+/// before row prompt_tokens - 1 - GLMTAIL_BACK (default 1: a chat template may render the previous turn's
+/// generation prompt differently in the next request). 0 = off. flash_checkpoint.h flash_tail_point is the same rule.
+pub fn flash_tail_point(prompt_tokens: u32) -> u32 {
+    use std::sync::OnceLock;
+    static BACK: OnceLock<Option<u32>> = OnceLock::new();
+    let back = *BACK.get_or_init(|| {
+        if std::env::var("GLMTAIL").ok().as_deref() != Some("1") {
+            return None;
+        }
+        Some(std::env::var("GLMTAIL_BACK").ok().and_then(|v| v.parse().ok()).unwrap_or(1))
+    });
+    match back {
+        Some(b) if prompt_tokens > b + 1 => (prompt_tokens - 1 - b) / 64 * 64,
+        _ => 0,
+    }
+}
